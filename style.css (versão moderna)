* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    font-family: 'Arial', sans-serif;
}

body {
    background-color: #f0f7f0;
    color: #333;
    line-height: 1.6;
}

header {
    background-color: #2e7d32;
    color: white;
    padding: 15px 0;
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    padding: 15px 20px;
}

header .logo h1 {
    margin-left: 10px;
}

header nav ul {
    list-style: none;
    display: flex;
    gap: 15px;
}

header nav ul li a {
    color: white;
    text-decoration: none;
    font-weight: bold;
    padding: 8px 15px;
    border-radius: 5px;
    transition: background 0.3s, transform 0.2s;
}

header nav ul li a:hover {
    background-color: #1b5e20;
    transform: scale(1.05);
}

/* Hero */
.hero {
    background-color: #a5d6a7;
    text-align: center;
    padding: 40px 20px;
    margin-bottom: 30px;
    border-radius: 8px;
}

.hero h2 {
    color: #1b5e20;
    margin-bottom: 15px;
}

.hero p {
    font-size: 1.1em;
}

.cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 20px;
    max-width: 1100px;
    margin: auto;
}

.card {
    background-color: #e8f5e9;
    padding: 15px;
    border-radius: 8px;
    text-align: center;
    transition: transform 0.3s, box-shadow 0.3s;
}

